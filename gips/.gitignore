.tools
tla2tools.jar

# Secrets and local state.
#
# `guix.scm` packages this repository with `(local-file "." #:recursive? #t)`,
# which copies the entire working tree into a world-readable /gnu/store item.
# A signing key sitting in the checkout — say, one passed to `--private-key` —
# therefore becomes readable by every user on the machine, and stays there for
# as long as the store item does. Committing one is worse still.
#
# Keep key material OUTSIDE the checkout: put it in the gipsd config directory
# (`$XDG_CONFIG_HOME/gips`, mode 0700, keys mode 0600) or another path outside
# the repository, and point `trust.signing.narinfo_private_key` at it. These
# patterns are a backstop, not the policy.
*.pem
*.key
*.sqlite
gipsd.toml

# TLA+ and TLC Intermediates
states/
*_TTrace_*

# LaTeX Intermediates (from tla2tex / pdflatex)
*.aux
*.log
*.dvi
*.out
*.toc
*.tex
.build/
.claude/
