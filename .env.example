# Copy to .env and fill in local Oracle resource identifiers.
# Do not put OCI private keys, fingerprints, or other credentials here.
ORACLE_IMAGE_ID=ocid1.image...
ORACLE_SUBNET_ID=ocid1.subnet...
ORACLE_INSTANCE_ID=ocid1.instance...
ORACLE_EVIDENCE_DIR=.oracle-validation/evidence/name
ORACLE_IMAGE_FILE=.oracle-validation/builds/ov2-current/guix-oracle-generic.qcow2
ORACLE_BUCKET_NAME=guix-images
ORACLE_OBJECT_NAME=guix-generic-metadata-unique.qcow2
ORACLE_UPLOAD_PART_MIB=128
# Optional defaults for the packaged one-shot validator. Keep COMMAND reviewed:
# it is executed on a disposable OCI guest when `make oracle-run` is invoked.
ORACLE_SOURCE=.
ORACLE_COMMAND=./run-tests.sh
